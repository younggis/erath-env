# Copy to .env. All values can also be overridden by real environment variables.
EARTHSIM_DATA_MODE=live
EARTHSIM_HTTP_PORT=8080
EARTHSIM_UI_TIMEZONE=local
EARTHSIM_STORAGE_ROOT=/data

#采集周期（秒）
EARTHSIM_GFS_POLL_SECONDS=900
EARTHSIM_GFS_MAX_LEAD_HOURS=36
EARTHSIM_OISST_STALE_AFTER_HOURS=480
EARTHSIM_CAMS_STALE_AFTER_HOURS=24
EARTHSIM_FIRMS_MIN_FRP_MW=10.0
EARTHSIM_NDBC_STALE_AFTER_MINUTES=240
EARTHSIM_VOLUME_MAX_LEAD_HOURS=3
EARTHSIM_WAVE_MAX_LEAD_HOURS=3
EARTHSIM_GEFS_MAX_LEAD_HOURS=6
EARTHSIM_SATELLITE_POLL_SECONDS=300
EARTHSIM_METAR_POLL_SECONDS=300
EARTHSIM_REALTIME_POLL_SECONDS=180
EARTHSIM_DERIVED_CACHE_GIB=12

# NASA FIRMS 火点（免费 MAP_KEY，https://firms.modaps.eosdis.nasa.gov/api/map_key/）
# 留空则禁用 FIRMS；EONET 野火事件仍可用
EARTHSIM_FIRMS_MAP_KEY=
EARTHSIM_MIN_FREE_DISK_GIB=8

# 单机 / 非 Docker 本地运行时把存储放到仓库旁的 .local-data
EARTHSIM_LOCAL_DATA_DIR=.local-data
